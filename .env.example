# Hexday environment variables
# Copy this file to .env and adjust values for your machine.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=hexday
POSTGRES_PASSWORD=hexday_dev_password
POSTGRES_DB=hexday

# --- API ---
PORT=3000
HOST=127.0.0.1

# Connection string the API uses to reach Postgres
DATABASE_URL=postgresql://hexday:hexday_dev_password@127.0.0.1:5432/hexday
